---
interface Props {
  type?: 'general' | 'health' | 'political' | 'sensitive';
  message?: string;
}

const { type = 'general', message } = Astro.props;

const disclaimers = {
  general: {
    icon: '⚠️',
    title: 'Entertainment Notice',
    text: message || 'This content explores conspiracy theories for discussion and entertainment purposes only. Claims presented here should not be taken as factual without independent verification from credible sources.',
  },
  health: {
    icon: '⚠️',
    title: 'Health & Safety Disclaimer',
    text: message || 'This content discusses health-related conspiracy theories for entertainment purposes only. Always consult qualified medical professionals for health decisions. Vaccines, medical treatments, and public health measures should be evaluated based on scientific evidence, not internet speculation.',
  },
  political: {
    icon: '⚠️',
    title: 'Political Content Notice',
    text: message || 'This discusses political conspiracy theories for entertainment and cultural analysis. Presented claims should not be taken as factual. Verify political information through multiple credible news sources.',
  },
  sensitive: {
    icon: '⚠️',
    title: 'Content Warning',
    text: message || 'This topic involves claims about real people and organizations. Presented here for cultural analysis only. No claims are endorsed as factual. Speculation should not be confused with evidence.',
  },
};

const disclaimer = disclaimers[type];
---

<div class={`disclaimer disclaimer-${type}`}>
  <div class="disclaimer-heading">
    <span class="disclaimer-icon">{disclaimer.icon}</span>
    <strong>{disclaimer.title}</strong>
  </div>
  <p class="disclaimer-text">{disclaimer.text}</p>
  <slot />
</div>

<style>
  .disclaimer {
    padding: var(--space-6);
    margin: var(--space-8) 0;
    border-radius: 4px;
    border: 3px solid;
  }

  .disclaimer-general {
    background: rgba(255, 210, 63, 0.1);
    border-color: var(--color-warning);
    border-left-width: 8px;
  }

  .disclaimer-health {
    background: rgba(238, 66, 102, 0.1);
    border-color: var(--color-danger);
    border-left-width: 8px;
  }

  .disclaimer-political {
    background: rgba(17, 138, 178, 0.1);
    border-color: var(--color-info);
    border-left-width: 8px;
  }

  .disclaimer-sensitive {
    background: rgba(155, 93, 229, 0.1);
    border-color: var(--color-mystery);
    border-left-width: 8px;
  }

  .disclaimer-heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
  }

  .disclaimer-general .disclaimer-heading {
    color: var(--color-warning);
  }

  .disclaimer-health .disclaimer-heading {
    color: var(--color-danger);
  }

  .disclaimer-political .disclaimer-heading {
    color: var(--color-info);
  }

  .disclaimer-sensitive .disclaimer-heading {
    color: var(--color-mystery);
  }

  .disclaimer-icon {
    font-size: var(--text-xl);
  }

  .disclaimer-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin: 0;
  }
</style>
