---
interface Props {
  title: string;
  slug: string;
  summary: string;
  category: string;
  dangerLevel: number;
  absurdityMeter: number;
  rabbitHoleScore: number;
}

const { title, slug, summary, category, dangerLevel, absurdityMeter, rabbitHoleScore } = Astro.props;

const categoryLabels: Record<string, string> = {
  'urban-planning': 'Urban Planning',
  'health': 'Health',
  'money': 'Money',
  'culture': 'Culture',
  'media': 'Media',
  'surveillance': 'Surveillance',
  'paranoia': 'Paranoia',
};
---

<article class="topic-card">
  <div class="card-header">
    <span class="category-badge">{categoryLabels[category]}</span>
  </div>
  
  <a href={`/topics/${slug}`} class="card-link">
    <h3 class="card-title">{title}</h3>
    <p class="card-summary">{summary}</p>
  </a>
  
  <div class="card-footer">
    <div class="score-badges">
      <span class="badge badge-danger" title="Danger Level">
        🔥 {dangerLevel}
      </span>
      <span class="badge badge-absurd" title="Absurdity Meter">
        🎪 {absurdityMeter}
      </span>
      <span class="badge badge-rabbit" title="Rabbit Hole Score">
        🐰 {rabbitHoleScore}
      </span>
    </div>
  </div>
</article>

<style>
  .topic-card {
    background: var(--color-bg-elevated);
    border: 2px solid var(--color-border);
    padding: var(--space-6);
    border-radius: 4px;
    transition: all var(--transition-normal);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .topic-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
  }

  .card-header {
    margin-bottom: var(--space-3);
  }

  .category-badge {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    padding: var(--space-1) var(--space-3);
    background: rgba(59, 206, 172, 0.2);
    color: var(--color-classified);
    border: 1px solid var(--color-classified);
    border-radius: 2px;
    letter-spacing: 0.05em;
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    flex-grow: 1;
    display: block;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-3);
    color: var(--color-text);
    line-height: var(--leading-tight);
  }

  .card-summary {
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .card-footer {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .score-badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    border-radius: 12px;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    font-family: var(--font-ui);
    border: 1px solid;
  }

  .badge-danger {
    background: rgba(239, 71, 111, 0.2);
    color: var(--color-danger-score);
    border-color: var(--color-danger-score);
  }

  .badge-absurd {
    background: rgba(255, 210, 63, 0.2);
    color: var(--color-absurd-score);
    border-color: var(--color-absurd-score);
  }

  .badge-rabbit {
    background: rgba(155, 93, 229, 0.2);
    color: var(--color-rabbit-score);
    border-color: var(--color-rabbit-score);
  }
</style>
